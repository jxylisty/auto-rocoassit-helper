{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "洛克王国 PVP 助手",
  "version": "2.0.0",
  "identifier": "com.lkwg.pvpassistant",
  "build": {
    "frontendDist": "../src/gui/web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "洛克王国 · PVP 助手控制台",
        "url": "index.html",
        "width": 1280,
        "height": 860,
        "minWidth": 880,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "decorations": false
      },
      {
        "label": "float",
        "title": "挂机悬浮战况",
        "url": "float_console.html",
        "width": 380,
        "height": 520,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false
      },
      {
        "label": "pvp_float",
        "title": "PVP 对决实时推演",
        "url": "pvp_float_overlay.html",
        "width": 420,
        "height": 600,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
